# Copy to .dev.vars for Wrangler. These values are for local development only.
BETTER_AUTH_URL=http://localhost:8788
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bridge secrets: set privately in Cloudflare Pages; never commit actual values.
ACCOUNTS_API_KEY=
GAME_JWT_PRIVATE_KEY=
# Empty denies all cross-origin game token access until exact origins are reviewed.
GAME_AUTH_ORIGINS=
